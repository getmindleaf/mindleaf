---
const year = new Date().getFullYear();
---

<footer>
	<a href="/" class="footer-logo">
		<img src="/assets/nobg_whitetext_mindleaf_logo.png" alt="Mindleaf">
	</a>
	<div class="footer-links">
		<a href="/privacy">Privacy Policy</a>
		<a href="/terms">Terms of Use</a>
		<a href="/support">Contact</a>
	</div>
	<span class="footer-copy">© {year} Mindleaf</span>
</footer>

<style>
footer{
  background:#060906;padding:28px 40px;
  display:flex;align-items:center;justify-content:space-between;
  border-top:0.5px solid rgba(255,255,255,0.06);
  font-family:'Figtree',sans-serif;line-height:1.7;
}
.footer-logo{display:flex;align-items:center;gap:8px;text-decoration:none}
.footer-logo img{height:36px;width:auto;max-width:100%;opacity:.6}
.footer-links{display:flex;gap:24px;flex-wrap:wrap}
.footer-links a{font-size:12px;color:rgba(255,255,255,0.2);text-decoration:none;transition:color .2s}
.footer-links a:hover{color:rgba(255,255,255,0.5)}
.footer-copy{font-size:11px;color:rgba(255,255,255,0.12)}

@media(max-width:900px){
  footer{flex-direction:column;gap:16px;text-align:center;padding:28px 20px}
  .footer-links{justify-content:center}
}
</style>
