---
// Mirrors the <nav> in src/pages/index.html — keep the two in sync.
---

<nav>
	<a href="/" class="nav-logo">
		<img src="/assets/nobg_mindleaf_logo.png" alt="Mindleaf logo">
	</a>
	<div class="nav-actions">
		<a href="/blog" class="nav-link">Blog</a>
		<a href="https://apps.apple.com/us/app/mindleaf-a-breathing-app/id6776819757" class="btn-store-sm btn-apple-sm">
			<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
			<span>App Store</span>
		</a>
	</div>
</nav>

<style>
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  background:rgba(248,249,246,0.92);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  border-bottom:0.5px solid #DCE8DC;
  padding:0 40px;
  display:flex;align-items:center;justify-content:space-between;
  height:64px;
  font-family:'Figtree',sans-serif;line-height:1.7;
}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none;min-width:0}
.nav-logo img{height:48px;width:auto;max-width:100%}
.nav-actions{display:flex;gap:10px;align-items:center;flex-shrink:0}
.nav-link{font-family:'Figtree',sans-serif;font-size:14px;color:#1A1A18;text-decoration:none;padding:8px 12px;white-space:nowrap}
.nav-link:hover{color:#1A1A18}
.btn-store-sm{
  display:inline-flex;align-items:center;gap:7px;
  font-family:'Figtree',sans-serif;font-size:12px;font-weight:500;
  padding:8px 16px;border-radius:9px;text-decoration:none;
  transition:all .2s;cursor:pointer;border:none;white-space:nowrap;
}
.btn-apple-sm{background:#1A1A18;color:#fff}
.btn-apple-sm:hover{background:#2a2a28;color:#fff}
.btn-store-sm svg{width:14px;height:14px;flex-shrink:0}

@media(max-width:900px){
  nav{padding:0 20px}
}
@media(max-width:480px){
  nav{padding:0 16px;gap:12px}
  .nav-logo img{height:36px}
  .nav-actions{gap:4px}
  .nav-link{padding:8px}
  .btn-store-sm{padding:8px 12px}
}
</style>
